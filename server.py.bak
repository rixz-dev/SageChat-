# ---------------------------------------------------------------------------
# ROUTES — upload
# ---------------------------------------------------------------------------
@app.route("/api/upload", methods=["POST"])
def api_upload():
    f = request.files.get("file")
    if not f:
        return jsonify({"error": "tidak ada file"}), 400
    raw = f.read()
    if len(raw) > MAX_UPLOAD_BYTES:
        return jsonify({"error": f"file terlalu besar (maks {MAX_UPLOAD_BYTES // 1024 // 1024}MB)"}), 400

    mime = f.mimetype or mimetypes.guess_type(f.filename)[0] or "application/octet-stream"
    is_image = mime.startswith("image/")
    upload_id = uuid.uuid4().hex[:10]
    stored_name = f"{upload_id}_{f.filename}"
    (UPLOADS_DIR / stored_name).write_bytes(raw)

    index = _read_json(UPLOAD_INDEX_PATH, {})
    index[upload_id] = {"filename": f.filename, "stored_name": stored_name, "mime": mime, "is_image": is_image}
    _write_json(UPLOAD_INDEX_PATH, index)

    return jsonify({"id": upload_id, "filename": f.filename, "is_image": is_image,
                     "url": f"/uploads/{stored_name}"})


@app.route("/api/github_direct", methods=["POST"])
def api_github_direct():
    """Dipanggil langsung dari modal GitHub di UI saat USER klik tombol (Simpan/Hapus/PR/dst).
    Ini beda dari jalur agent di run_turn(): di sini user sendiri yang menekan tombol di panel,
    jadi klik itu SUDAH JADI konfirmasi eksplisit — tidak perlu permission-gate tambahan lagi.
    Kalau AI yang minta lewat obrolan, tetap wajib lewat permission-gate di run_turn()."""
    action_data = request.get_json(force=True, silent=True) or {}
    action = action_data.get("action", "")
    result_text, ok = execute_github(action_data)
    if not ok:
        return jsonify({"success": False, "error": result_text, "output": result_text})
    if action in ("list_tree", "list_workflows"):
        try:
            items = json.loads(result_text)
        except json.JSONDecodeError:
            items = []
        return jsonify({"success": True, "items": items})
    if action == "read_file":
        return jsonify({"success": True, "content": result_text})
    return jsonify({"success": True, "output": result_text})


