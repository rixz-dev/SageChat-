@app.route("/api/memory", methods=["GET", "POST"])
def api_memory():
    if request.method == "GET":
        return jsonify(load_memory())
    body = request.get_json(force=True, silent=True) or {}
    text = (body.get("text") or "").strip()
    if not text:
        return jsonify({"error": "text kosong"}), 400
    items = load_memory()
    items.append({"id": uuid.uuid4().hex[:8], "text": text, "created_at": time.time()})
    save_memory(items)
    return jsonify(items)


@app.route("/api/memory/<mid>", methods=["DELETE"])
def api_memory_delete(mid):
    items = [m for m in load_memory() if m["id"] != mid]
    save_memory(items)
    return jsonify(items)


